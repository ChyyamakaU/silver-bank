# ---------------------------------------------------------------------------
# Silver Bank Backend - environment configuration (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=silver_bank_dev
DB_TEST_NAME=silver_bank_test
DB_USER=postgres
DB_PASSWORD=change_me
# Set to "true" for managed providers that require SSL (Render, Aiven, etc.)
DB_SSL=false
# Aiven / managed Postgres TLS: provide the provider's CA certificate (ca.pem).
# Prefer a path (relative paths resolve from the backend directory):
# DB_SSL_CA_PATH=./certs/ca.pem
# Or supply it inline: raw PEM with escaped newlines, or a base64-encoded PEM.
# DB_SSL_CA=
# Verify the server certificate against the CA. Keep "true" in production.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10

# JWT secrets - use long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=silver-bank
JWT_AUDIENCE=silver-bank-customers

# Password hashing
BCRYPT_ROUNDS=12

# Cookies (refresh token)
COOKIE_SECRET=replace_with_a_long_random_cookie_secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Banking rules (amounts are in kobo; 100 kobo = NGN 1.00)
CURRENCY=NGN
CURRENCY_MINOR_UNITS=2
TRANSFER_MIN_AMOUNT=100
TRANSFER_MAX_AMOUNT=100000000
TRANSFER_DAILY_LIMIT=500000000
BCRYPT_MAX_BYTES=72
# Welcome bonus credited to every newly registered customer (kobo; 100000 = NGN 1,000.00). Set 0 to disable.
SIGNUP_BONUS=100000
# Opening capital of the internal bank funding account that sources signup bonuses (kobo).
FUNDING_ACCOUNT_BALANCE=1000000000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Bootstrap administrator (used only by the seeder)
ADMIN_EMAIL=admin@silverbank.test
ADMIN_PASSWORD=Admin@Silver123
ADMIN_NAME=Silver Bank Administrator

# Frontend URL (used in emails/receipts links, informational)
FRONTEND_URL=http://localhost:5173
